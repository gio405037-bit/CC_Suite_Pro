<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:CCSuitePro.Services" x:Class="CCSuitePro.SplashWindow" Title="CC Suite Pro" Width="860" Height="500" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="26" BorderBrush="{DynamicResource Theme.Brush.22314B}" BorderThickness="1" Background="{DynamicResource CCSuite.Background.SplashGradient}">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-80,-60,0,0" Fill="{DynamicResource CCSuite.Background.SplashBlueGlow}">
                </Ellipse>
                <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-90,-70" Fill="{DynamicResource CCSuite.Background.SplashPurpleGlow}">
                </Ellipse>

                <StackPanel VerticalAlignment="Center" Margin="12,0,30,0">
                    <Border Width="112" Height="112" CornerRadius="22" HorizontalAlignment="Left" BorderBrush="{DynamicResource Theme.Brush.204A7D}" BorderThickness="1" Background="{DynamicResource CCSuite.Background.SplashLogo}">
                        <Grid>
                            <Image Source="pack://application:,,,/Resources/WinterSplashLogo.png" Width="108" Height="108" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="CC SUITE PRO" Margin="0,26,0,0" Foreground="White" FontSize="36" FontWeight="Bold"/>
                    <TextBlock Text="{Binding [splash_subtitle], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Margin="0,8,0,0" Foreground="{DynamicResource Theme.Brush.B6C2D6}" FontSize="16"/>
                    <TextBlock x:Name="RegularSplashTag" Text="{Binding [splash_stability_gate], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Margin="0,8,0,0" Foreground="{DynamicResource Theme.Brush.6FA8FF}" FontSize="13"/>

                    <!-- Seasonal introduction only when Winter Edition and its welcome option are enabled. -->
                    <StackPanel x:Name="WinterWelcomeIntro" Visibility="Collapsed" Margin="0,10,0,0" IsHitTestVisible="False">
                        <Border Width="245" HorizontalAlignment="Left" CornerRadius="11" Background="#493039" BorderBrush="#B65563" BorderThickness="1" Padding="12,6">
                            <TextBlock Text="❄ WINTER EDITION 2026" FontSize="15" FontWeight="Bold" Foreground="#FFE7EB"/>
                        </Border>
                        <TextBlock x:Name="WinterWelcomeGreeting" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#E8C4CD" FontSize="13"/>
                    </StackPanel>

                    <TextBlock x:Name="StageText" Text="{Binding [splash_initializing], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Margin="0,28,0,0" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailText" Text="{Binding [splash_loading_services], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Margin="0,8,0,0" Foreground="{DynamicResource Theme.Brush.95A5C1}" FontSize="13"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" CornerRadius="22" Padding="22" BorderBrush="{DynamicResource Theme.Brush.22314B}" BorderThickness="1" Background="{DynamicResource Theme.Brush.120F1E}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="{Binding [splash_startup], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PercentText" Text="8%" Foreground="{DynamicResource Theme.Brush.6FA8FF}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <Border Background="{DynamicResource Theme.Brush.0D1729}" BorderBrush="{DynamicResource Theme.Brush.1C3152}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                            <DockPanel>
                                <Ellipse x:Name="Step1Dot" Width="10" Height="10" Fill="{DynamicResource Theme.Brush.50A4FF}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [splash_loading_settings_label], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Foreground="{DynamicResource Theme.Brush.D6E3F8}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource Theme.Brush.0D1729}" BorderBrush="{DynamicResource Theme.Brush.1C3152}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                            <DockPanel>
                                <Ellipse x:Name="Step2Dot" Width="10" Height="10" Fill="{DynamicResource Theme.Brush.36506F}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Step2Text" Text="{Binding [splash_applying_language_label], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Foreground="{DynamicResource Theme.Brush.95A5C1}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource Theme.Brush.0D1729}" BorderBrush="{DynamicResource Theme.Brush.1C3152}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                            <DockPanel>
                                <Ellipse x:Name="Step3Dot" Width="10" Height="10" Fill="{DynamicResource Theme.Brush.36506F}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Step3Text" Text="{Binding [splash_preparing_interface_label], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Foreground="{DynamicResource Theme.Brush.95A5C1}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <ProgressBar x:Name="SplashProgressBar" Height="8" Minimum="0" Maximum="100" Value="8" Background="{DynamicResource Theme.Brush.1A2740}" Foreground="{DynamicResource Theme.Brush.50A4FF}"/>
                        <TextBlock Text="{Binding [splash_please_wait], Source={x:Static services:LanguageService.Instance}, Mode=OneWay}" Margin="0,10,0,0" Foreground="{DynamicResource Theme.Brush.7889A9}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Snow is visual-only; original startup progress stays fully functional. -->
            <Canvas x:Name="WinterWelcomeSnowOverlay" Grid.ColumnSpan="2" Grid.ZIndex="10"
                    IsHitTestVisible="False" ClipToBounds="True" Opacity="0.62" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>