<Window x:Class="CCSuitePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CC Suite Pro - by Megarorun" Height="750" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    
    <Border Background="#0D1117" CornerRadius="12">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Background="#161B22" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    
                    <TextBlock Text="CC Suite Pro" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="_" Click="MinimizeWindow" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8B949E" Width="46" Height="32" FontSize="14" Cursor="Hand"/>
                    <Button Content="[]" Click="MaximizeWindow" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8B949E" Width="46" Height="32" FontSize="14" Cursor="Hand"/>
                    <Button Content="X" Click="CloseWindow" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#8B949E" Width="46" Height="32" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Grid>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                
                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="#161B22">
                    <StackPanel Margin="0,20,0,0">
                        <StackPanel Margin="20,0,20,30"><TextBlock Text="CC SUITE" Foreground="#58A6FF" FontSize="24" FontWeight="Bold"/><TextBlock Text="PROFESSIONAL" Foreground="#8B949E" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                        <Border Height="1" Background="#21262D" Margin="16,0,16,20"/>
                        <TextBlock Text="LIBRARY" Tag="library" Foreground="#484F58" FontSize="10" FontWeight="Bold" Margin="20,0,0,10"/>
                        
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="0"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Dashboard" Tag="dashboard"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="1"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileMultiple" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="All Files" Tag="all_files"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="2"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Duplicates" Tag="duplicates"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="3"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Conflicts" Tag="conflicts"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="4"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Broom" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Cleaner" Tag="cleaner"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Click="SwitchTab" Tag="5"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Settings" Tag="settings"/></StackPanel></Button>
                        
                        <TextBlock Text="TOOLS" Tag="tools" Foreground="#484F58" FontSize="10" FontWeight="Bold" Margin="20,30,0,10"/>
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding OrganizeCommand}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderMove" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Organize" Tag="organize"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding BackupCommand}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Backup" Tag="backup"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding ScanCommand}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Text="Refresh Scan" Tag="refresh_scan"/></StackPanel></Button>
                        
                        <StackPanel Margin="20,40,20,20">
                            <Border Background="#0D1117" CornerRadius="8" Padding="12" BorderBrush="#21262D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CC Suite Pro" Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="v2.0 Beta &quot;Post Genesis&quot;" Foreground="#58A6FF" FontSize="11" Margin="0,4,0,0"/>
                                    <TextBlock Text="by Megarorun" Foreground="#8B949E" FontSize="10" Margin="0,2,0,0"/>
                                    <TextBlock Text="Free and Open Source" Foreground="#484F58" FontSize="10" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- CONTENT -->
                <Grid Grid.Column="1" Background="#0D1117">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#161B22" Padding="20,16" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Library" Foreground="#E6EDF3" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding StatusMessage}" Foreground="#8B949E" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0D1117" CornerRadius="6" BorderBrush="#21262D" BorderThickness="1" Width="250" Height="36" Margin="0,0,12,0"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" Margin="12,0"/></Border>
                                <Button Content="+ Add Mods" Style="{StaticResource ActionButton}" Command="{Binding InstallModsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <WrapPanel Grid.Row="1" Margin="20,16,20,0">
                        <Border Style="{StaticResource StatsCard}" Width="180"><StackPanel><TextBlock Text="FILES" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TotalFiles}" Foreground="#58A6FF" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border Style="{StaticResource StatsCard}" Width="180"><StackPanel><TextBlock Text="SIZE" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TotalSizeFormatted, Mode=OneWay}" Foreground="#D29922" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border Style="{StaticResource StatsCard}" Width="180"><StackPanel><TextBlock Text="DUPS" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding DuplicateCount, Mode=OneWay}" Foreground="#D29922" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                        <Border Style="{StaticResource StatsCard}" Width="180"><StackPanel><TextBlock Text="CONFLICTS" Foreground="#8B949E" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ConflictCount, Mode=OneWay}" Foreground="#DA3633" FontSize="28" FontWeight="Bold"/></StackPanel></Border>
                    </WrapPanel>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Style="{StaticResource CircularSpinner}" Margin="0,0,10,0"/>
                            <TextBlock Text="Scanning..." Foreground="#58A6FF" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    
                    <TabControl Grid.Row="2" x:Name="MainTabs" Background="Transparent" BorderThickness="0" Margin="20,12,20,20">
                        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                        
                        <!-- TAB 0: Dashboard -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Padding="30" Margin="0,8,0,0"><StackPanel>
                            <TextBlock Text="Welcome to CC Suite Pro" Foreground="#E6EDF3" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Your Sims 4 Mod Manager" Foreground="#8B949E" FontSize="16" Margin="0,8,0,30"/>
                            <Button Content="Get Started" Style="{StaticResource ActionButton}" Width="300" Height="44" Command="{Binding InstallModsCommand}"/>
                            <TextBlock Text="Created by Megarorun" Foreground="#58A6FF" FontSize="14" Margin="0,40,0,0"/>
                        </StackPanel></Border></TabItem>
                        
                        <!-- TAB 1: All Files -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Margin="0,8,0,0"><ListView ItemsSource="{Binding ModFiles}" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9"><ListView.View><GridView><GridViewColumn Header="NAME" Width="400" DisplayMemberBinding="{Binding FileName}"/><GridViewColumn Header="SIZE" Width="100" DisplayMemberBinding="{Binding FileSizeFormatted}"/><GridViewColumn Header="TYPE" Width="100" DisplayMemberBinding="{Binding Extension}"/><GridViewColumn Header="CATEGORY" Width="150" DisplayMemberBinding="{Binding Category}"/></GridView></ListView.View></ListView></Border></TabItem>
                        
                        <!-- TAB 2: Duplicates -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,8,0,0"><ScrollViewer><StackPanel><TextBlock Text="Duplicate Files" Foreground="#E6EDF3" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Foreground="#D29922" FontSize="14" Margin="0,0,0,20"><Run Text="Found "/><Run Text="{Binding DuplicateCount, Mode=OneWay}"/><Run Text=" groups"/></TextBlock><ItemsControl ItemsSource="{Binding DuplicateGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#0D1117" CornerRadius="8" Padding="16" Margin="0,0,0,8"><StackPanel><TextBlock Foreground="#E6EDF3" FontWeight="SemiBold"><Run Text="{Binding Files.Count}"/><Run Text=" files"/></TextBlock><ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border></TabItem>
                        
                        <!-- TAB 3: Conflicts -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,8,0,0"><ScrollViewer><StackPanel><TextBlock Text="Conflicts" Foreground="#E6EDF3" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Foreground="#DA3633" FontSize="14" Margin="0,0,0,20"><Run Text="Found "/><Run Text="{Binding ConflictCount, Mode=OneWay}"/><Run Text=" conflicts"/></TextBlock><ListBox ItemsSource="{Binding Conflicts}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="#0D1117" CornerRadius="8" Padding="16" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding ConflictType}" Foreground="#DA3633" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/><TextBlock Text="{Binding Description}" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></ScrollViewer></Border></TabItem>
                        
                        
                        
<!-- TAB 4: Cleaner -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Padding="30" Margin="0,8,0,0"><StackPanel><TextBlock Text="Junk Cleaner" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="{Binding CleanStatus, Mode=OneWay}" Foreground="#8B949E" FontSize="14" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Button Content="Scan" Style="{StaticResource ActionButton}" Command="{Binding ScanJunkCommand}" Width="140" Height="40" Margin="0,0,10,0"/><Button Content="Clean All" Style="{StaticResource ActionButton}" Command="{Binding CleanAllCommand}" Width="120" Height="40"/></StackPanel><TextBlock Text="Cache, Empty, Temp, Corrupted files" Foreground="#484F58" FontSize="12"/></StackPanel></Border></TabItem>
                        
                        <!-- TAB 5: Settings -->
                        <TabItem><Border Background="#161B22" CornerRadius="8" Padding="30" Margin="0,8,0,0"><ScrollViewer><StackPanel>
                            <TextBlock Text="Settings" Foreground="#E6EDF3" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>
                            <TextBlock Text="Mods Folder" Foreground="#8B949E" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ModsFolderPath, Mode=OneWay}" Foreground="#E6EDF3" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Height="36" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource ActionButton}" Command="{Binding SelectModsFolderCommand}" Width="100" Height="36" Margin="10,0,0,0"/></Grid>
                            <TextBlock Text="Cache Folder" Foreground="#8B949E" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding CacheFolderPath, Mode=OneWay}" Foreground="#E6EDF3" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Height="36" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource ActionButton}" Command="{Binding SelectCacheFolderCommand}" Width="100" Height="36" Margin="10,0,0,0"/></Grid>
                            <TextBlock Text="Language" Foreground="#8B949E" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="4" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20">
                                <ComboBox SelectedIndex="{Binding SelectedLanguageIndex}" Foreground="#E6EDF3" Background="Transparent" BorderThickness="0" Height="34">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Espanol"/>
                                    <ComboBoxItem Content="Korean"/>
                                </ComboBox>
                            </Border>
                            <Button Content="Save Settings" Style="{StaticResource ActionButton}" Command="{Binding SaveSettingsCommand}" Width="160" Height="40" Margin="0,20,0,0"/>
                            <TextBlock Text="Restart required to apply language" Foreground="#DA3633" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel></ScrollViewer></Border></TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
